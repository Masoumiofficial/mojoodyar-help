])
#step("۲", [پوشهٔ قدیمی را تغییر نام دهید], [
  در FileZilla به `/wp-content/plugins/` بروید و پوشهٔ #strong[Mojoodyar] را
  به `Mojoodyar-old` تغییر نام دهید. این کار یک نسخهٔ برگشت سریع برایتان
  نگه می‌دارد.
])
#step("۳", [نسخهٔ جدید را آپلود کنید], [
